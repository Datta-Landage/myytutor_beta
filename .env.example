# Database Configuration
DB_HOST=your-database-host
DB_PORT=25060
DB_NAME=your-database-name
DB_USER=your-database-user
DB_PASSWORD=your-database-password
DB_SSLMODE=REQUIRED

# Spring Datasource
SPRING_DATASOURCE_URL=jdbc:mysql://your-host:port/your-database?useSSL=true&requireSSL=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=your-database-user
SPRING_DATASOURCE_PASSWORD=your-database-password

# Spring Profile
SPRING_PROFILES_ACTIVE=dev

# Email Configuration
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_SMTP_AUTH=true
MAIL_SMTP_SSL_ENABLE=false
MAIL_SMTP_STARTTLS_ENABLE=true

# Frontend Security
FRONTEND_SECRET=your-frontend-secret-key

# JWT Configuration
JWT_SECRET=your-jwt-secret-key-min-256-bits
JWT_TOKEN_VALIDITY=86400000

# Google API
GOOGLE_API_KEY=your-google-places-api-key

# WhatsApp Provider (twilio or meta)
WHATSAPP_PROVIDER=meta

# Twilio WhatsApp Configuration (if using twilio)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_ADMIN_NUMBER=whatsapp:+91XXXXXXXXXX

# WhatsApp Business Cloud API (if using meta)
WHATSAPP_API_URL=https://graph.facebook.com/v22.0
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_BUSINESS_ACCOUNT_ID=your-business-account-id
WHATSAPP_ACCESS_TOKEN=your-access-token
WHATSAPP_VERIFY_TOKEN=your-verify-token
WHATSAPP_ADMIN_PHONE=919623947782
WHATSAPP_COMMUNITY_ID=your-community-invite-link
