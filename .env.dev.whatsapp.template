# ========================================
# WHATSAPP BUSINESS CLOUD API CONFIGURATION
# ========================================
# Get your credentials from: https://developers.facebook.com/apps/
# Full setup guide: See WHATSAPP_SETUP_GUIDE.md

# WhatsApp Phone Number ID (from Meta Business Suite)
# Location: WhatsApp > API Setup > Phone number ID
# Example: 123456789012345
WHATSAPP_PHONE_NUMBER_ID=YOUR_PHONE_NUMBER_ID_HERE

# WhatsApp Permanent Access Token (System User Token recommended)
# Location: Meta Business Suite > Users > System Users > Generate Token
# Starts with: EAA...
# NEVER commit this to git - keep it secret!
WHATSAPP_ACCESS_TOKEN=YOUR_PERMANENT_ACCESS_TOKEN_HERE

# Admin WhatsApp Number (receives full inquiry details)
# Format: Country code + phone number (no + or spaces)
# Example: 919623947782 for +91 9623947782
WHATSAPP_ADMIN_PHONE=919623947782

# WhatsApp Community/Group ID (where inquiries are broadcasted)
# Get from: WhatsApp Web > Group Info > Copy invite link
# Format: 120363XXXXXXXXXX@g.us
WHATSAPP_COMMUNITY_ID=YOUR_COMMUNITY_ID_HERE

# Webhook Verify Token (your own random secure string)
# Used to verify webhook requests from Meta
# Create a strong random string, e.g.: mySecureToken_2025_XyZ123
# Use same value in Meta dashboard webhook configuration
WHATSAPP_VERIFY_TOKEN=mySecureVerifyToken123

# ========================================
# QUICK SETUP CHECKLIST
# ========================================
# [ ] 1. Create Meta Business Account
# [ ] 2. Create WhatsApp app
# [ ] 3. Generate permanent access token
# [ ] 4. Get phone number ID
# [ ] 5. Create WhatsApp community/group
# [ ] 6. Copy community ID
# [ ] 7. Configure webhook in Meta dashboard
# [ ] 8. Update all values above
# [ ] 9. Test with sample inquiry
# [ ] 10. Monitor logs for success

